{
  "productName": "CADFlow",
  "version": "0.1.2",
  "identifier": "com.cadflow.dev",
  "build": {
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run vite-build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
    "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "app": {
    "windows": [
      {
        "title": "CADFlow",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/FenrirDWolf/CAD-Flow/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4NUFDRDJDQjJENUU0MzAKUldRdzVOV3lMTTFhV05xbktJaTVsd3VlSWZMVks0OWJPcFk1N3lhU2xGdVlBcDAxcXNMNDI4b2IK"
    },
    "core": {
      "invoke": {
        "allowlist": [
          "get_cad_installations",
          "mount_drive",
          "unmount_drive",
          "check_file_in_use",
          "upload_file",
          "acquire_lock",
          "launch_file"
        ]
      }
    }
  }
}




